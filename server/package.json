{
  "name": "weather-outfit-server",
  "version": "1.0.0",
  "description": "Fetches weather from Open-Meteo and returns outfit recommendations for the Weather + Outfit Suggester app.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src test",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^9.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/lib/outfit.js"
    ],
    "coverageThreshold": {
      "./src/lib/outfit.js": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ]
  }
}
